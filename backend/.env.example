# ===== SignalFlow 后端环境变量示例 =====
# 复制为 .env 后按环境填写；.env 已被 .gitignore 排除，禁止提交真实密钥。

# 应用
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# 数据库（开发默认本地 PostgreSQL + pgvector 镜像）
DATABASE_URL=postgresql+psycopg://signalflow:signalflow@localhost:5432/signalflow

# 向量检索（与数据库同实例时无需单独配置；如使用独立向量库可在此覆盖）
# VECTOR_STORE_URL=

# LLM 网关（LiteLLM）：provider/api_key/model 从环境注入
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=60
# 可选降级模型，LiteLLM 支持多 provider 路由
# LLM_FALLBACK_MODEL=

# Embedding（去重/聚类用）
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=

# 缓存
REDIS_URL=redis://localhost:6379/0