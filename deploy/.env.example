# SignalFlow docker compose 环境变量样例：复制为 .env 后按需修改（.env 不提交版本库）

# PostgreSQL
POSTGRES_USER=signalflow
POSTGRES_PASSWORD=signalflow
POSTGRES_DB=signalflow

# 端口映射
BACKEND_PORT=8000
FRONTEND_PORT=8080

# Redis
REDIS_URL=redis://redis:6379/0

# LLM（生产环境必须填写真实密钥；仅演示时保持 WORKFLOW_LLM_ENABLED=false）
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_FALLBACK_MODEL=

# Embedding
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=

# 工作流开关：false 时 LangGraph 走旁路，不发起真实 LLM 调用
WORKFLOW_LLM_ENABLED=false